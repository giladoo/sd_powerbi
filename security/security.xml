<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_sd_powerbi">
        <field name="name">sd_powerbi</field>
        <field name="description">requests.</field>
    </record>

    <record id="groupi_users" model="res.groups">
        <field name="name">Users</field>
        <field name="category_id" ref="module_category_sd_powerbi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_operators" model="res.groups">
        <field name="name">Operators</field>
        <field name="category_id" ref="module_category_sd_powerbi"/>
        <field name="implied_ids" eval="[(4, ref('groupi_users'))]"/>
    </record>

    <record id="group_admins" model="res.groups">
        <field name="name">Administrators</field>
        <field name="category_id" ref="module_category_sd_powerbi"/>
        <field name="implied_ids" eval="[(4, ref('group_operators'))]"/>
    </record>


    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sd_powerbi.group_admins'))]"/>
    </record>


</odoo>
