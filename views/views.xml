<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="records_list" model="ir.ui.view">
        <field name="name">Project List</field>
        <field name="model">sd_powerbi.records</field>
        <field name="arch" type="xml">
            <list>
                <header>
<!--                    <button string="UUID" name="update_uuid" type="object" class="btn bg-danger-light" groups="base.group_system"></button>-->
                </header>
                <field name="name"/>
                <field name="users" />

            </list>
        </field>
    </record>

    <record id="records_form" model="ir.ui.view">
        <field name="name">Project Form</field>
        <field name="model">sd_powerbi.records</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="users"/>
                    </group>
                    <group>
<!--                        <field name="code" widget="code" style="font-family: 'Roboto' !important;"/>-->
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="records_window_action" model="ir.actions.act_window">
        <field name="name">Power Bi</field>
        <field name="res_model">sd_powerbi.records</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
            id="sd_powerbi_nemu"
            name="Power BI"
            action="records_window_action"
    />
</odoo>